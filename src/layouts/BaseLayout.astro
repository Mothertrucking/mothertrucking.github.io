---
import '../styles/global.scss';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  navTheme?: 'dark' | 'light';
}

const {
  title = 'Mothertrucking Apps — Product studio for the transport sector',
  description = 'We build software for the people who keep things moving. Apps for the transport and lifting sector, made in New Zealand.',
  navTheme = 'dark',
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-QF43RDE1RR"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-QF43RDE1RR');
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />

  <title>{title}</title>

  <link rel="icon" href="/img/favicon.png" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />

  <!-- Font Awesome -->
  <script src="https://kit.fontawesome.com/bdc8ff9353.js" crossorigin="anonymous"></script>
</head>
<body>
  <Nav theme={navTheme} />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
