---
interface Props {
  href: string;
  target?: string;
  variant?: 'primary' | 'ghost' | 'geomarqr';
}

const { href, target, variant = 'primary' } = Astro.props;
---

<a href={href} target={target} class:list={['btn', `btn--${variant}`]}>
  <slot />
</a>

<style lang="scss">
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 13px $sz-xl;
    border-radius: 2px;
    font-family: $font-body;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    cursor: pointer;
    text-decoration: none;
    border: 1px solid transparent;

    &:hover { text-decoration: none; }

    &--primary {
      background-color: $cl-primary-500;
      color: #fff;
      border-color: $cl-primary-500;
      &:hover { background-color: $cl-primary-700; border-color: $cl-primary-700; }
    }

    &--geomarqr {
      background-color: #B91D2D;
      color: #fff;
      border-color: #B91D2D;
      &:hover { background-color: #9e1826; border-color: #9e1826; }
    }

    &--ghost {
      background-color: transparent;
      color: rgba(#fff, 0.6);
      border-color: rgba(#fff, 0.18);
      &:hover {
        color: #fff;
        border-color: rgba(#fff, 0.45);
      }
    }
  }
</style>
