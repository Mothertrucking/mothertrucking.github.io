---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
import { ACTION_ERROR_CODES } from 'astro:actions';

const partners = [
  'Siemens',
  'Michelin',
  'Cisco',
  'Singapore Gov.',
  'Crane Association of NZ',
];
---

<BaseLayout
  title="Mothertrucking Apps — Software studio for the transport sector"
  description="We build apps for the people who keep things moving. Forged in New Zealand."
>

  <!-- ─── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero__bg">
      <img src="/img/hero-road.jpg" alt="" aria-hidden="true" />
    </div>
    <div class="gutter hero__inner">
      <div class="hero__text">
        <div class="hero__logo-lockup">
          <img src="/img/logo-horizontal-whitesvg.svg" alt="Mothertrucking Apps" class="hero__logo" />
          <p class="hero__eyebrow">presents</p>
        </div>
        <h1 class="hero__headline">geoMarqr.</h1>
        <p class="hero__sub">Built to work when nothing else does. Real-time geotagged photo reporting for emergency services, insurance, and field workers.</p>
        <div class="hero__actions">
          <Button href="https://geomarqr.com" target="_blank" variant="geomarqr">Visit geoMarqr.com</Button>
        </div>
      </div>
      <div class="hero__phone-col">
        <div class="mockup-phone">
          <div class="mockup-phone-camera"></div>
          <div class="mockup-phone-display">
            <div class="hero__phone-map"></div>
            <div class="hero__phone-ui">
              <div class="hero__phone-pin">
                <i class="fa-solid fa-location-dot"></i>
              </div>
              <div class="hero__phone-card">
                <span class="hero__phone-card-label">Photo tagged</span>
                <span class="hero__phone-card-loc">-36.8485° S, 174.7633° E</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="hero__scroll" aria-hidden="true">
      <span>Scroll</span>
      <div class="hero__scroll-line"></div>
    </div>
  </section>

  <!-- ─── What we do ───────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="gutter what">
      <div class="what__text">
        <div class="what__heading">
          <p class="eyebrow">NZ Forged</p>
          <h2>Indie Studio</h2>
        </div>
        <p>We build our own apps, own the IP, and ship them independently.</br> No clients, no briefs, no overheads, fast swift decisions.</p>
        <p>Think indie game studio, but with roots in the sector. We find the problems worth solving and build the software to solve them.</p>

        <div class="what__awards">
          <div class="what__awards-row">
            <div class="what__award">
              <img src="/img/wreathLeft.svg" alt="" aria-hidden="true" class="what__award-wreath what__award-wreath--left" />
              <div class="what__award-text">
                <span class="what__award-name">Min. of Awesome</span>
                <span class="what__award-type">People's Choice</span>
              </div>
              <img src="/img/wreathLeft.svg" alt="" aria-hidden="true" class="what__award-wreath what__award-wreath--right" />
            </div>
            <div class="what__award">
              <img src="/img/wreathLeft.svg" alt="" aria-hidden="true" class="what__award-wreath what__award-wreath--left" />
              <div class="what__award-text">
                <span class="what__award-name">Min. of Awesome</span>
                <span class="what__award-type">Te Puawai</span>
              </div>
              <img src="/img/wreathLeft.svg" alt="" aria-hidden="true" class="what__award-wreath what__award-wreath--right" />
            </div>
          </div>
          <div class="what__awards-row what__awards-row--center">
            <div class="what__award">
              <img src="/img/wreathLeft.svg" alt="" aria-hidden="true" class="what__award-wreath what__award-wreath--left" />
              <div class="what__award-text">
                <span class="what__award-name">Soda Inc.</span>
                <span class="what__award-type">People's Choice</span>
              </div>
              <img src="/img/wreathLeft.svg" alt="" aria-hidden="true" class="what__award-wreath what__award-wreath--right" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Products ────────────────────────────────────────────────────────── -->
  <div class="products">

    <a href="https://geomarqr.com" target="_blank" class="product product--geomarqr">
      <div class="product__content">
        <span class="product__label">Live</span>
        <h2 class="product__name">Geomarqr</h2>
        <p class="product__sub">Built to work when nothing else does.</p>
      </div>
    </a>

    <div class="product product--tides">
      <div class="product__content">
        <span class="product__label">Coming soon to Geomarqr</span>
        <h2 class="product__name">Tides</h2>
        <p class="product__sub">Know exactly when to head out.</p>
      </div>
    </div>

    <a href="https://lowcode.co.nz" target="_blank" class="product product--enterprise">
      <div class="product__content">
        <span class="product__label">Enterprise</span>
        <h2 class="product__name">lowcode.co.nz</h2>
        <p class="product__sub">Serious problems deserve serious software.</p>
      </div>
    </a>

  </div>

  <!-- ─── Team ────────────────────────────────────────────────────────────── -->
  <section class="section section--team-header">
    <div class="gutter team-header">
      <p class="eyebrow">The Allstar Dream Team</p>
      <h2>The A-Team</h2>
      <p class="team-header__sub">Each member is an Award-winning CEO, published speaker and internationally recognized industry leader.</br>
        
    </div>
  </section>

  <div class="team">

    <div class="member member--jason">
      <div class="member__icon"><i class="fa-thin fa-terminal"></i></div>
      <div class="member__content">
        <p class="member__bio">The tinkerer. The guy that gets the contraptions working. Award-winning UX and low-code leader.</p>
        <p class="member__role">Technical Co-founder</p>
        <h3>Jason Teunissen</h3>
        <a href="https://www.linkedin.com/in/%F0%9F%A4%99jason-teunissen-537a9327/" class="member__linkedin" target="_blank" rel="noopener" aria-label="Jason Teunissen on LinkedIn">
          <i class="fa-brands fa-linkedin"></i>
          <span class="member__linkedin-title">CEO · lowcode.co.nz</span>
        </a>
      </div>
    </div>

    <div class="member member--kitti">
      <div class="member__icon"><i class="fa-thin fa-heart"></i></div>
      <div class="member__content">
        <p class="member__bio">The heart. She talks with everyone, makes sure every voice is heard, and keeps us moving in the right direction. Award-winning startup founder.</p>
        <p class="member__role">CEO · Co-founder</p>
        <h3>Kitti Bradley</h3>
        <a href="https://www.linkedin.com/in/kitti-bradley/" class="member__linkedin" target="_blank" rel="noopener" aria-label="Kitti Bradley on LinkedIn">
          <i class="fa-brands fa-linkedin"></i>
          <span class="member__linkedin-title">CEO · Mothertrucking</span>
        </a>
      </div>
    </div>

    <div class="member member--michelle">
      <div class="member__icon"><i class="fa-thin fa-people-group"></i></div>
      <div class="member__content">
        <p class="member__bio">GTM strategist and fractional leader. She knows everyone, understands people deeply, and brings the network to match. Former Senior Director at a company acquired by Cisco for $3B.</p>
        <p class="member__role">Fractional GTM Strategist</p>
        <h3>Michelle Allbon</h3>
        <a href="https://www.linkedin.com/in/michelleallbon/" class="member__linkedin" target="_blank" rel="noopener" aria-label="Michelle Allbon on LinkedIn">
          <i class="fa-brands fa-linkedin"></i>
          <span class="member__linkedin-title">CEO · Fractional Directory</span>
        </a>
      </div>
    </div>

    <div class="member member--mystery">
      <div class="member__icon"><i class="fa-thin fa-infinity"></i></div>
      <div class="member__content">
        <p class="member__bio">Mad scientist. Tinkerer. Runs a million-dollar company and still finds time to get their hands dirty. Identity stays under wraps — for now.</p>
        <p class="member__role">Identity withheld</p>
        <h3>The Mentor</h3>
        <span class="member__linkedin member__linkedin--placeholder">
          <span class="member__linkedin-title">CEO</span>
        </span>
      </div>
    </div>

  </div>

  <!-- ─── Partners strip ───────────────────────────────────────────────────── -->
  <section class="section section--tinted">
    <div class="gutter">
      <p class="section__label">Worked with</p>
      <ul class="partner-names">
        {partners.map(p => <li>{p}</li>)}
      </ul>
    </div>
  </section>

<script src="../scripts/parallax.js"></script>

</BaseLayout>

<style lang="scss">
  // ─── Hero ──────────────────────────────────────────────────────────────────
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;

    &__bg {
      position: absolute;
      inset: 0;
      z-index: 0;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 40%;
        filter: brightness(0.25);
      }
    }

    &__inner {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      gap: $sz-2xl;
      padding-block: 160px 0;

      @media (max-width: $bp-md) {
        grid-template-columns: 1fr;
        padding-block: 120px $sz-3xl;
      }
    }

    &__text {
      display: flex;
      flex-direction: column;
      gap: $sz-xl;
      justify-content: center;
      padding-bottom: $sz-3xl;
    }

    &__phone-col {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;

      @media (max-width: $bp-md) { display: none; }
    }

    &__phone-map {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 60% 45%, rgba(#B91D2D, 0.15) 0%, transparent 55%),
        linear-gradient(160deg, #0a0d14 0%, #0d1520 40%, #0a0a0e 100%);

      // Subtle grid lines mimicking a map
      &::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(#fff, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(#fff, 0.03) 1px, transparent 1px);
        background-size: 56px 56px;
      }
    }

    &__phone-ui {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 24px;
      padding-top: 96px;
    }

    &__phone-pin {
      font-size: 84px;
      color: #B91D2D;
      filter: drop-shadow(0 8px 32px rgba(#B91D2D, 0.6));
      line-height: 1;
    }

    &__phone-card {
      background: rgba(#fff, 0.06);
      border: 1px solid rgba(#fff, 0.1);
      border-radius: 24px;
      padding: 20px 28px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      backdrop-filter: blur(8px);
      width: 80%;
    }

    &__phone-card-label {
      font-size: 18px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: rgba(#fff, 0.4);
    }

    &__phone-card-loc {
      font-size: 22px;
      font-weight: 600;
      color: rgba(#fff, 0.75);
      font-family: 'SF Mono', 'Fira Code', monospace;
    }

    &__logo-lockup {
      margin-bottom: -29px;
    }

    &__logo {
      width: 100%;
      max-width: 365px;
      height: auto;
      opacity: 0.6;
    }

    &__eyebrow {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: #B91D2D;
      margin-top: -12px;
    }

    &__headline {
      font-family: $font-display;
      font-weight: 900;
      font-size: clamp(56px, 10vw, 128px);
      line-height: 0.92;
      letter-spacing: -0.03em;
      color: #fff;

      &::after { content: none; }
    }

    &__sub {
      font-size: clamp(16px, 1.8vw, 20px);
      color: rgba(#fff, 0.5);
      line-height: 1.6;
      max-width: 460px;
    }

    &__actions {
      display: flex;
      gap: $sz-md;
      flex-wrap: wrap;
      padding-top: $sz-sm;
    }

    &__scroll {
      position: absolute;
      bottom: $sz-xl;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: $sz-sm;

      span {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: rgba(#fff, 0.2);
      }
    }

    &__scroll-line {
      width: 1px;
      height: 48px;
      background: linear-gradient(to bottom, rgba(#fff, 0.2), rgba(#fff, 0));
    }
  }

  .mockup-phone {
    background-color: #000;
    border: 4px solid #4e4d4d;
    border-radius: 50px;
    margin: 0 auto;
    padding: 6px;
    display: inline-block;
    overflow: hidden;
    width: min(320px, 100%);
    box-shadow:
      0 0 0 2px rgba(#fff, 0.06),
      0 80px 160px rgba(#000, 0.9),
      0 30px 60px rgba(#000, 0.6);

    .mockup-phone-camera {
      background: #000;
      border-radius: 9999px;
      width: 33%;
      height: 25px;
      margin: 0 auto;
      position: relative;
      top: 5px;
      z-index: 10;

      &::after {
        content: "";
        background-color: #2a292d;
        border-radius: 5px;
        width: 12px;
        height: 12px;
        position: absolute;
        top: 25%;
        right: 8%;
      }
    }

    .mockup-phone-display {
      border-radius: 40px;
      margin-top: -25px;
      overflow: hidden;
      position: relative;
      width: 100%;
      aspect-ratio: 390 / 844;
    }
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: $cl-primary-500;
  }

  // ─── Partners strip ────────────────────────────────────────────────────────
  // ─── Sections ──────────────────────────────────────────────────────────────
  .section {
    padding-block: $sz-3xl;
    background: $cl-dark-500;

    &--tinted {
      background: $cl-dark-700;
      padding-block: $sz-xl;
    }

    // h2 treatment on dark bg — echoes the global style but legible on dark
    h2 {
      color: rgba(#fff, 0.12);
    }
  }

  .section__label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(#fff, 0.25);
    margin-bottom: $sz-lg;
    text-align: center;
  }

  // ─── What we do ────────────────────────────────────────────────────────────
  .what {
    &__heading {
      display: flex;
      flex-direction: column;
      gap: $sz-xs;
    }

    &__text {
      max-width: 620px;
      margin: 0 auto;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: $sz-lg;

      h2 {
        font-family: $font-display;
        font-weight: 900;
        font-size: clamp(40px, 6vw, 80px);
        color: rgba(#fff, 0.12);
        letter-spacing: -0.03em;
        text-transform: uppercase;

        &::after { content: '.'; }
      }

      p {
        font-size: clamp(16px, 1.6vw, 19px);
        line-height: 1.7;
        color: rgba(#fff, 0.55);
      }
    }

    &__awards {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: $sz-lg;
      margin-top: $sz-2xl;
    }

    &__awards-row {
      display: flex;
      justify-content: center;
      gap: $sz-xl;
    }

    &__award {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    &__award-text {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }

    &__award-name {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 13px;
      font-style: italic;
      color: rgba(#fff, 0.7);
    }

    &__award-type {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(#fff, 0.35);
    }

    &__award-wreath {
      width: 24px;
      height: auto;
      opacity: 0.5;
      filter: brightness(0) invert(1);

      &--right {
        transform: scaleX(-1);
      }
    }
  }

  // ─── Products (Housemarque style) ──────────────────────────────────────────
  .products {
    display: flex;
    flex-direction: column;
  }

  .product {
    position: relative;
    display: block;
    height: 45vh;
    min-height: 280px;
    overflow: hidden;
    text-decoration: none;

    background-size: cover;
    background-position: center 20%;
    background-repeat: no-repeat;

    @media (max-width: $bp-md) { height: 30vh; }

    &--geomarqr {
      background-image: url('/img/hero-road.jpg');
    }

    &--tides {
      background-image: url('/img/Gemini_Generated_Image_smb6dcsmb6dcsmb6.png');
    }

    &--enterprise {
      background-image: url('/img/lcnzOffice.png');
    }

    // Dark scrim
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(#000, 0.55);
      transition: background 0.5s ease;
    }

    &:hover { text-decoration: none; }
    &:hover::after { background: rgba(#000, 0.42); }

    &__content {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: $sz-2xl $sz-3xl;
      gap: $sz-sm;

      @media (max-width: $bp-md) { padding: $sz-xl; }
    }

    &__label {
      font-family: $font-body;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: rgba(#fff, 0.5);
    }

    &__name {
      font-family: $font-display;
      font-weight: 900;
      font-size: clamp(32px, 5vw, 72px);
      line-height: 0.95;
      letter-spacing: -0.03em;
      color: #fff;
      text-transform: uppercase;

      &::after { content: none; }
    }

    &__sub {
      font-family: $font-body;
      font-size: clamp(14px, 1.4vw, 18px);
      color: rgba(#fff, 0.6);
      line-height: 1.5;
      max-width: 480px;
    }
  }

  // ─── Team ──────────────────────────────────────────────────────────────────
  .section--team-header {
    padding-block: $sz-2xl $sz-xl;
  }

  .team-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: $sz-sm;

    h2 {
      margin: 0;
    }

    &__sub {
      max-width: 52ch;
      color: rgba(#fff, 0.55);
      font-size: 15px;
      line-height: 1.6;
    }
  }

  .team {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    @media (max-width: $bp-lg) { grid-template-columns: repeat(2, 1fr); }
    @media (max-width: $bp-md) { grid-template-columns: repeat(2, 1fr); }
  }

  .member {
    position: relative;
    height: 80vh;
    min-height: 360px;
    overflow: hidden;

    // Image layer
    &::before {
      content: '';
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center center;
      transition: transform 0.5s ease;
    }

    &:hover::before {
      transform: scale(1.05);
    }

    // Dark scrim
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(#000, 0.85) 0%, rgba(#000, 0.2) 60%, rgba(#000, 0.1) 100%);
    }

    // Placeholder bg — replace with real photo per member
    &--jason    { background-color: $cl-dark-700; &::before { background-image: url('/img/jasonRender.png'); } }
    &--kitti    { background-color: $cl-dark-500; &::before { background-image: url('/img/kittiRender.png'); } }
    &--michelle { background-color: #1a2830; &::before { background-image: url('/img/michelleRender4.png'); } }
    &--mystery  { background-color: #111; &::before { background-image: url('/img/mentorRender2.png'); } }

    &__icon {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 3;
      font-size: 48px;
      color: rgba(#fff, 0.9);
      line-height: 1;
    }

    &__content {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: $sz-xl;
      gap: 4px;
      transition: transform 0.4s ease;
    }

    &:hover &__content {
      transform: translateY(-60px);
    }

    &__bio {
      font-size: 13px;
      line-height: 1.6;
      color: rgba(#fff, 0.75);
      margin-bottom: 12px;
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 0.4s ease 0.05s, transform 0.4s ease 0.05s;
    }

    &:hover &__bio {
      opacity: 1;
      transform: translateY(0);
    }

    &__role {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: rgba(#fff, 0.4);
    }

    h3 {
      font-size: clamp(16px, 1.8vw, 22px);
      font-weight: 700;
      color: #fff;
      line-height: 1.2;
    }

    &__linkedin {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 10px;
      color: rgba(#fff, 0.6);
      font-size: 20px;
      line-height: 1;
      text-decoration: none;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.35s ease 0.1s, transform 0.35s ease 0.1s, color 0.2s ease;

      &:hover {
        color: #0A66C2;
      }
    }

    &__linkedin-title {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: rgba(#fff, 0.4);
      transition: color 0.2s ease;

      .member__linkedin:hover & {
        color: rgba(#0A66C2, 0.8);
      }
    }

    &:hover &__linkedin {
      opacity: 1;
      transform: translateY(0);
    }

    &__linkedin--placeholder {
      display: inline-flex;
      align-items: center;
      margin-top: 10px;
      pointer-events: none;
    }

  }

