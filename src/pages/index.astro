---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';

const partners = [
  'Michelin',
  'Crane Association of NZ',
  'McLeod Cranes',
  'Gisborne Hiabs',
  'Lift N Shift',
];
---

<BaseLayout
  title="Mothertrucking Apps — Software studio for the transport sector"
  description="We build apps for the people who keep things moving. Forged in New Zealand."
>

  <!-- ─── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero__bg">
      <img src="/img/hero-road.jpg" alt="" aria-hidden="true" />
    </div>
    <div class="gutter hero__inner">
      <img src="/img/logo-horizontal-dispatch.svg" alt="Mothertrucking Apps" class="hero__logo" />
      <p class="hero__eyebrow">presents</p>
      <h1 class="hero__headline">geoMarqr.</h1>
      <p class="hero__sub">Built to work when nothing else does. Real-time geotagged photo reporting for emergency services, insurance, and field workers.</p>
      <div class="hero__actions">
        <Button href="https://geomarqr.com" target="_blank" variant="geomarqr">Visit geoMarqr.com</Button>
      </div>
    </div>
    <div class="hero__scroll" aria-hidden="true">
      <span>Scroll</span>
      <div class="hero__scroll-line"></div>
    </div>
  </section>

  <!-- ─── Partners ─────────────────────────────────────────────────────────── -->
  <section class="partners">
    <div class="gutter partners__inner">
      <span class="partners__label">Worked with</span>
      <ul class="partners__list">
        {partners.map(p => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <!-- ─── What we do ───────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="gutter what">
      <div class="what__text">
        <div class="what__heading">
          <p class="eyebrow">NZ Forged</p>
          <h2>Indie Studio.</h2>
        </div>
        <p>We're an indie studio. We build our own apps, own the IP, and ship them independently — no clients, no briefs, no overheads, fast swift decisions.</p>
        <p>Think indie game studio, but for the transport sector. We find the problems worth solving and build the software to solve them.</p>
      </div>
    </div>
  </section>

  <!-- ─── Products ────────────────────────────────────────────────────────── -->
  <div class="products">

    <a href="https://geomarqr.com" target="_blank" class="product product--geomarqr">
      <div class="product__content">
        <span class="product__label">Live</span>
        <h2 class="product__name">Geomarqr</h2>
        <p class="product__sub">Built to work when nothing else does.</p>
      </div>
    </a>

    <a href="/tides" class="product product--tides">
      <div class="product__content">
        <span class="product__label">Coming soon to Geomarqr</span>
        <h2 class="product__name">Tides</h2>
        <p class="product__sub">Know exactly when to head out.</p>
      </div>
    </a>

    <a href="/enterprise" class="product product--enterprise">
      <div class="product__content">
        <span class="product__label">Enterprise</span>
        <h2 class="product__name">lowcode.co.nz</h2>
        <p class="product__sub">Serious problems deserve serious software.</p>
      </div>
    </a>

  </div>

  <!-- ─── Team ────────────────────────────────────────────────────────────── -->
  <div class="team">

    <div class="member member--jason">
      <div class="member__content">
        <p class="member__role">Founder · Developer</p>
        <h3>Jason Teunissen</h3>
      </div>
    </div>

    <div class="member member--kitti">
      <div class="member__content">
        <p class="member__role">Co-founder · Brand & Business</p>
        <h3>Kitti Bradley</h3>
      </div>
    </div>

    <div class="member member--michelle">
      <div class="member__content">
        <p class="member__role">Fractional GTM Strategist</p>
        <h3>Michelle Allbon</h3>
      </div>
    </div>

    <div class="member member--mystery">
      <div class="member__content">
        <p class="member__role">Identity withheld</p>
        <h3>The Mentor</h3>
      </div>
    </div>

  </div>

  <!-- ─── Partners strip ───────────────────────────────────────────────────── -->
  <section class="section section--tinted">
    <div class="gutter">
      <p class="section__label">Industry partners</p>
      <ul class="partner-names">
        {partners.map(p => <li>{p}</li>)}
      </ul>
    </div>
  </section>

<script src="../scripts/parallax.js"></script>

</BaseLayout>

<style lang="scss">
  // ─── Hero ──────────────────────────────────────────────────────────────────
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;

    &__bg {
      position: absolute;
      inset: 0;
      z-index: 0;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 40%;
        filter: brightness(0.25);
      }
    }

    &__inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: $sz-xl;
      padding-block: 160px $sz-3xl;
    }

    &__logo {
      width: 100%;
      max-width: 260px;
      height: auto;
      opacity: 0.85;
    }

    &__eyebrow {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: #B91D2D;
    }

    &__headline {
      font-family: $font-display;
      font-weight: 900;
      font-size: clamp(56px, 10vw, 128px);
      line-height: 0.92;
      letter-spacing: -0.03em;
      color: #fff;

      &::after { content: none; }
    }

    &__sub {
      font-size: clamp(16px, 1.8vw, 20px);
      color: rgba(#fff, 0.5);
      line-height: 1.6;
      max-width: 460px;
    }

    &__actions {
      display: flex;
      gap: $sz-md;
      flex-wrap: wrap;
      padding-top: $sz-sm;
    }

    &__scroll {
      position: absolute;
      bottom: $sz-xl;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: $sz-sm;

      span {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: rgba(#fff, 0.2);
      }
    }

    &__scroll-line {
      width: 1px;
      height: 48px;
      background: linear-gradient(to bottom, rgba(#fff, 0.2), rgba(#fff, 0));
    }
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: $cl-primary-500;
  }

  // ─── Partners strip ────────────────────────────────────────────────────────
  .partners {
    border-bottom: 1px solid rgba(#fff, 0.06);
    padding-block: $sz-lg;
    background: $cl-dark-700;

    &__inner {
      display: flex;
      align-items: center;
      gap: $sz-xl;
      flex-wrap: wrap;

      @media (max-width: $bp-md) { flex-direction: column; align-items: flex-start; gap: $sz-md; }
    }

    &__label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: rgba(#fff, 0.25);
      white-space: nowrap;
    }

    &__list {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: $sz-sm $sz-xl;

      li {
        font-size: 14px;
        font-weight: 600;
        color: rgba(#fff, 0.4);
      }
    }
  }

  // ─── Sections ──────────────────────────────────────────────────────────────
  .section {
    padding-block: $sz-3xl;
    background: $cl-dark-500;

    &--tinted { background: $cl-dark-700; }

    // h2 treatment on dark bg — echoes the global style but legible on dark
    h2 {
      color: rgba(#fff, 0.12);
    }
  }

  .section__label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(#fff, 0.25);
    margin-bottom: $sz-xl;
  }

  // ─── What we do ────────────────────────────────────────────────────────────
  .what {
    &__heading {
      display: flex;
      flex-direction: column;
      gap: $sz-xs;
    }

    &__text {
      max-width: 620px;
      display: flex;
      flex-direction: column;
      gap: $sz-lg;

      h2 {
        font-family: $font-display;
        font-weight: 900;
        font-size: clamp(40px, 6vw, 80px);
        color: rgba(#fff, 0.12);
        letter-spacing: -0.03em;
        text-transform: uppercase;

        &::after { content: '.'; }
      }

      p {
        font-size: clamp(16px, 1.6vw, 19px);
        line-height: 1.7;
        color: rgba(#fff, 0.55);
      }
    }
  }

  // ─── Products (Housemarque style) ──────────────────────────────────────────
  .products {
    display: flex;
    flex-direction: column;
  }

  .product {
    position: relative;
    display: block;
    height: 45vh;
    min-height: 280px;
    overflow: hidden;
    text-decoration: none;

    background-size: cover;
    background-position: center 20%;
    background-repeat: no-repeat;

    @media (max-width: $bp-md) { height: 30vh; }

    &--geomarqr {
      background-image: url('/img/hero-road.jpg');
    }

    // TODO: replace with real imagery before launch
    &--tides {
      background-image: url('https://images.squarespace-cdn.com/content/v1/5bfd4f00710699387b6a460a/1739446032039-LRWR71PA4LSB118YI2TA/Guest_4.jpg?format=2500w');
    }

    &--enterprise {
      background-image: url('https://images.squarespace-cdn.com/content/v1/5bfd4f00710699387b6a460a/1543839534570-PSLKYMHE9FIXVQ48YR9H/Marketing-Art_Final_large-1600x960.jpg?format=2500w');
    }

    // Dark scrim
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(#000, 0.55);
      transition: background 0.5s ease;
    }

    &:hover { text-decoration: none; }
    &:hover::after { background: rgba(#000, 0.42); }

    &__content {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: $sz-2xl $sz-3xl;
      gap: $sz-sm;

      @media (max-width: $bp-md) { padding: $sz-xl; }
    }

    &__label {
      font-family: $font-body;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: rgba(#fff, 0.5);
    }

    &__name {
      font-family: $font-display;
      font-weight: 900;
      font-size: clamp(32px, 5vw, 72px);
      line-height: 0.95;
      letter-spacing: -0.03em;
      color: #fff;
      text-transform: uppercase;

      &::after { content: none; }
    }

    &__sub {
      font-family: $font-body;
      font-size: clamp(14px, 1.4vw, 18px);
      color: rgba(#fff, 0.6);
      line-height: 1.5;
      max-width: 480px;
    }
  }

  // ─── Team ──────────────────────────────────────────────────────────────────
  .team {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    @media (max-width: $bp-lg) { grid-template-columns: repeat(2, 1fr); }
    @media (max-width: $bp-md) { grid-template-columns: repeat(2, 1fr); }
  }

  .member {
    position: relative;
    height: 60vh;
    min-height: 360px;
    background-size: cover;
    background-position: center top;
    overflow: hidden;

    // Dark scrim
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(#000, 0.85) 0%, rgba(#000, 0.2) 60%, rgba(#000, 0.1) 100%);
    }

    // Placeholder bg — replace with real photo per member
    &--jason    { background-image: url('/img/Gemini_Generated_Image_6x26ei6x26ei6x26.png'); background-color: $cl-dark-700; }
    &--kitti    { background-color: $cl-dark-500; }
    &--michelle { background-color: #1a2830; }
    &--mystery  { background-color: #111; }

    &__content {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: $sz-xl;
      gap: 4px;
    }

    &__role {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: rgba(#fff, 0.4);
    }

    h3 {
      font-size: clamp(16px, 1.8vw, 22px);
      font-weight: 700;
      color: #fff;
      line-height: 1.2;
    }

    &--mystery h3 {
      color: rgba(#fff, 0.25);
    }

    &--mystery &__role {
      color: rgba(#fff, 0.2);
    }
  }

  // ─── Partner names ─────────────────────────────────────────────────────────
  .partner-names {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: $sz-sm $sz-2xl;

    li {
      font-size: 15px;
      font-weight: 600;
      color: rgba(#fff, 0.3);
    }
  }
</style>
